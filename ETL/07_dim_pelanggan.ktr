    <connection>nrg_ecom conn</connection>
    <sql>SELECT
    c.customer_id,
    c.full_name,
    c.phone,
    a.city
FROM customers c
LEFT JOIN customer_addresses a
    ON a.customer_id = c.customer_id
   AND a.is_primary = 1;</sql>
    <limit>0</limit>
    <lookup/>
    <execute_each_row>N</execute_each_row>
