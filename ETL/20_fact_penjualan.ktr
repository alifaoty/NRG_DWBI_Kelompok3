    <rowlimit>0</rowlimit>
    <sql>SELECT sk_kampanye AS sk_kamp
FROM dim_kampanye
WHERE sk_kampanye > 0
  AND ? BETWEEN tgl_mulai AND tgl_selesai
  AND kanal_sasaran IN ('Semua Kanal', ?)
ORDER BY (ABS(target_diskon_persen - ?) > 0.5), tgl_mulai
LIMIT 1</sql>
