var sk_kampanye;
var atribusi_kampanye;

if (sk_kamp == null) {
    sk_kampanye = -1;
    atribusi_kampanye = "TIDAK_ADA";
} else {
    sk_kampanye = sk_kamp;
    atribusi_kampanye = "JENDELA_WAKTU";
}</jsScript_script>
