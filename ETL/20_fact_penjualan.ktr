    <connection>nrg_dw conn</connection>
    <sql>SELECT
    s.*,
    DATE(s.waktu_transaksi) AS tgl,
    100 * s.diskon /
        NULLIF(s.qty * s.harga_satuan_excl_ppn, 0) AS pct_diskon
FROM stg_penjualan s;</sql>
