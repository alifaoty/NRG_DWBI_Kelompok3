      <jsScript>
        <jsScript_type>0</jsScript_type>
        <jsScript_name>Script 1</jsScript_name>
        <jsScript_script>//Script here

var penjualan_kotor = qty * harga_satuan_excl_ppn;

var penjualan_bersih = penjualan_kotor - diskon;

var total_harga_pokok = (hpp == null)
    ? null
    : hpp * qty;

var margin_kotor = (hpp == null)
    ? null
    : penjualan_bersih - total_harga_pokok - fee_komisi - fee_layanan;

var flag_hpp_kosong = (hpp == null) ? 1 : 0;</jsScript_script>
      </jsScript>
    </jsScripts>
